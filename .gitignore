# ============================================================
# .gitignore · Diplomado en Ingeniería de Datos con Python
# ============================================================

# --- Datos: NUNCA subir datasets al repo ---
data/*
!data/.gitkeep
*.csv
*.parquet
*.xlsx
*.zip
*.db
*.sqlite

# --- Salidas generadas al correr los scripts ---
salida/
*.log

# --- Material solo-docente (guiones, guías, archivo antiguo, demos privadas) ---
_privado/

# --- Trabajo propio de cada alumno (no se mezcla con el material del curso) ---
mis_trabajos/

# --- Secretos y credenciales ---
.env
.env.*
kaggle.json
*.pem
.aws/
credentials
secrets.*

# --- Entorno de Python ---
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.pytest_cache/

# --- Sistema / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
